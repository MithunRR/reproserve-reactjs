# Copy to .env.local and edit, OR just leave unset for the default flow.
#
# Default (this var unset / commented):
#   - dev:  Vite proxies /api and /assets → http://localhost:3000 (local Node)
#   - prod: Express on the same domain serves /api itself (relative URLs)
#
# To make local dev hit the LIVE backend instead, set the URL below
# (no trailing slash) and restart `npm run dev`:
#
# VITE_API_BASE_URL=https://reproserve.creativecrows.com
