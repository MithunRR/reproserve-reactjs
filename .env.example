# ReproServe – optional environment variables
# Copy to .env and adjust if you add env-based config later.
# The app currently resolves API URL by hostname (see src/utils/api.ts).

# Optional: override API base URL at runtime (set before app loads, e.g. in index.html)
# window.API_BASE_URL = 'https://webrepro.creativecrows.com'

# If you switch to Vite env vars (VITE_*), uncomment and use:
# VITE_API_BASE_URL=https://webrepro.creativecrows.com
